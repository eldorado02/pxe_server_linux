# =============================================================
# Configuration du serveur PXE ShredOS
# =============================================================

# Source image locale (recommandé pour ce projet)
SHREDOS_SOURCE=local

# Dossier local contenant l'image ShredOS (.iso/.img/.img.tar.gz)
SHREDOS_LOCAL_DIR=./shredos-2025.11_28_i686_v0.40_20260204_lite-1

# Chemin vu depuis le conteneur PXE (volume monté depuis SHREDOS_LOCAL_DIR)
SHREDOS_LOCAL_PATH=/opt/local-shredos

# Version ShredOS à télécharger depuis GitHub
# "latest" = dernière release stable automatiquement
SHREDOS_VERSION=latest

# Profil d'effacement nwipe
# test conseillé: zero
# production conseillé: dod
NWIPE_METHOD=zero
NWIPE_VERIFY=off
NWIPE_EXTRA_OPTIONS=

# Dossier persistant pour les rapports sur l'hôte
RAPPORTS_DIR=./rapports

# Credentials FTP (reçoit les PDF/logs des clients)
FTP_USER=shredreports
FTP_PASS=shredos2025

# Lease DHCP partagé (utilisé pour retrouver la MAC et renommer les rapports)
LEASE_FILE=/home/shredreports/ftpdata/dnsmasq.leases
REPORT_RENAME_SCAN_INTERVAL=10
